# Copy to .env and fill in (e.g. with `openssl rand -hex 24`). Never commit .env.
PHP_VERSION=8.4
# PowerDNS for the test stack: powerdns/pdns-auth-49:4.9.18, powerdns/pdns-auth-50:5.0.8 or powerdns/pdns-auth-51:5.1.5
PDNS_IMAGE=powerdns/pdns-auth-51:5.1.5
PDNS_API_KEY=
NSEDIT_ADMIN_USER=admin
NSEDIT_ADMIN_PASSWORD=
# Optional: enables auto-login ("remember me") and long living csrf tokens
NSEDIT_SECRET=
NSEDIT_NS1=ns1.example.com.
NSEDIT_NS2=ns2.example.com.
WEB_BIND=127.0.0.1
WEB_PORT=8080
DNS_BIND=127.0.0.1
DNS_PORT=1053
